    {
      "parameters": {
        "jsCode": "const b = $json.body || {};\nif (b.secret !== 'jeancrg2026panel' || !b.contacto_id || !b.texto) return [{ json: { error: 'bad' } }];\nreturn [{ json: { ok: true, contacto_id: b.contacto_id, texto: b.texto } }];"
      },
      "id": "r2",
      "name": "Validar",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        300
      ]
    },
    {
