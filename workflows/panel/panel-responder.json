        "tableId": "contactos",
        "options": {
          "select": "*"
        }
      },
      "id": "r0",
      "name": "Traer Contacto",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 2,
      "position": [
        440,
        300
      ],
      "credentials": {
        "supabaseApi": {
          "id": "R3PLjsR3f3UEEp4r",
          "name": "Supabase account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const cid = $('Validar').item.json.contacto_id;\nconst c = $('Traer Contacto').all().flatMap(i => i.json).flat(1).find(x => x && x.id === cid);\nif (!c || !c.telefono) return [{ json: { error: 'no-contact', contacto_id: cid } }];\nreturn [{ json: { telefono: c.telefono, texto: $('Validar').item.json.texto, contacto_id: cid } }];"
      },
      "id": "r5",
      "name": "Buscar Telefono",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        680,
        300
      ]
    },
    {
      "parameters": {
        "resource": "message",
        "operation": "sendMessage",
        "phoneNumberId": "1309447485585504",
        "recipientPhoneNumber": "={{ $json.telefono }}",
        "text": "={{ $json.texto }}",
        "replyMarkup": "none",
        "additionalFields": {}
      },
      "id": "r3",
