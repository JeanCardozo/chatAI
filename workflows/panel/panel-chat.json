        "responseBody": "<!DOCTYPE html>\n<html lang=\"es\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>JeanCRG · Panel de Conversaciones</title>\n<style>\n:root{\n  --bg1:#070b14; --bg2:#0d1424; --card:#111a2e; --card2:#0c1526;\n  --border:rgba(148,163,184,.14); --text:#e2e8f0; --muted:#7c8aa5;\n  --acc1:#7c5cff; --acc2:#22d3ee; --gold:#f5b942; --ok:#34d399;\n  --err:#f87171; --radius:16px;\n}\n*{box-sizing:border-box;margin:0;padding:0}\nhtml,body{height:100%}\nbody{\n  font-family:Inter,-apple-system,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;\n  background:radial-gradient(1200px 600px at 80% -10%,rgba(124,92,255,.16),transparent 60%),\n             radial-gradient(1000px 500px at -10% 110%,rgba(34,211,238,.10),transparent 60%),\n             linear-gradient(160deg,var(--bg1),var(--bg2));\n  color:var(--text); display:flex; min-height:100vh;\n}\n.app{display:flex; width:100%; max-width:1280px; margin:0 auto; height:100vh; padding:18px; gap:18px}\n/* ── Sidebar ── */\n#lista{width:340px; min-width:300px; background:rgba(17,26,46,.72); border:1px solid var(--border); border-radius:var(--radius); backdrop-filter:blur(14px); display:flex; flex-direction:column; overflow:hidden}\n.lista-head{padding:16px 16px 12px; border-bottom:1px solid var(--border)}\n.brand{display:flex; align-items:center; gap:10px; margin-bottom:12px}\n.logo{width:34px;height:34px;border-radius:10px;background:linear-gradient(135deg,var(--acc1),var(--acc2));display:flex;align-items:center;justify-content:center;font-weight:800;color:#fff;font-size:16px;box-shadow:0 4px 14px rgba(124,92,255,.4)}\n.brand h1{font-size:15px;font-weight:700;letter-spacing:.2px}\n.brand small{display:block;color:var(--muted);font-size:11px;font-weight:500}\n#buscar{width:100%;padding:9px 12px;border-radius:10px;border:1px solid var(--border);background:rgba(10,18,36,.7);color:var(--text);font-size:13px;outline:none;transition:.2s}\n#buscar:focus{border-color:var(--acc1);box-shadow:0 0 0 3px rgba(124,92,255,.15)}\n.chat-list{flex:1;overflow-y:auto;padding:8px}\n.chat-list::-webkit-scrollbar,.msg-box::-webkit-scrollbar{width:6px}\n.chat-list::-webkit-scrollbar-thumb,.msg-box::-webkit-scrollbar-thumb{background:rgba(148,163,184,.2);border-radius:3px}\n.chat-item{padding:11px 12px;border-radius:12px;cursor:pointer;transition:.15s;border:1px solid transparent;margin-bottom:4px}\n.chat-item:hover{background:rgba(148,163,184,.08)}\n.chat-item.act{background:linear-gradient(135deg,rgba(124,92,255,.16),rgba(34,211,238,.10));border-color:rgba(124,92,255,.35)}\n.chat-item .row{display:flex;justify-content:space-between;align-items:center;gap:8px}\n.chat-item .nm{font-weight:600;font-size:13.5px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}\n.chat-item .nm.no{color:var(--muted);font-weight:500;font-style:italic}\n.chat-item .t{font-size:11px;color:var(--muted);white-space:nowrap}\n.chat-item .sub{font-size:12px;color:var(--muted);margin-top:3px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}\n.empty{padding:26px 14px;text-align:center;color:var(--muted);font-size:13px;line-height:1.5}\n.empty b{color:var(--text)}\n#status{display:flex;align-items:center;gap:7px;padding:10px 16px;border-top:1px solid var(--border);font-size:11.5px;color:var(--muted)}\n#dot{width:8px;height:8px;border-radius:50%;background:var(--ok);box-shadow:0 0 8px var(--ok)}\n#dot.err{background:var(--err);box-shadow:0 0 8px var(--err)}\n/* ── Principal ── */\n#main{flex:1;background:rgba(17,26,46,.55);border:1px solid var(--border);border-radius:var(--radius);backdrop-filter:blur(14px);display:flex;flex-direction:column;overflow:hidden}\n.msg-head{padding:14px 20px;border-bottom:1px solid var(--border);display:flex;align-items:center;gap:12px}\n.avatar{width:38px;height:38px;border-radius:50%;background:linear-gradient(135deg,var(--acc1),var(--acc2));display:flex;align-items:center;justify-content:center;font-weight:700;color:#fff;font-size:15px;flex:none}\n.msg-head .nm{font-weight:700;font-size:14.5px}\n.msg-head .ph{font-size:12px;color:var(--muted)}\n.msg-head .go{margin-left:auto;font-size:12px;color:var(--acc2);text-decoration:none;background:rgba(34,211,238,.1);border:1px solid rgba(34,211,238,.3);padding:7px 12px;border-radius:10px;transition:.15s}\n.msg-head .go:hover{background:rgba(34,211,238,.18)}\n.msg-box{flex:1;overflow-y:auto;padding:22px 24px;display:flex;flex-direction:column;gap:10px}\n.msg{max-width:68%;padding:10px 14px;border-radius:14px;font-size:13.5px;line-height:1.5;white-space:pre-wrap;word-wrap:break-word;animation:fade .2s ease}\n@keyframes fade{from{opacity:0;transform:translateY(4px)}to{opacity:1;transform:none}}\n.msg .meta{display:block;font-size:10.5px;opacity:.65;margin-top:4px}\n.msg.user{align-self:flex-start;background:rgba(148,163,184,.14);border-bottom-left-radius:4px}\n.msg.bot{align-self:flex-end;background:linear-gradient(135deg,rgba(124,92,255,.35),rgba(34,211,238,.25));border-bottom-right-radius:4px}\n.msg.human{align-self:flex-end;background:linear-gradient(135deg,rgba(245,185,66,.28),rgba(255,140,66,.20));border-bottom-right-radius:4px;border:1px solid rgba(245,185,66,.35)}\n.msg.human .tag{display:inline-block;font-size:10px;font-weight:700;color:var(--gold);margin-right:6px;letter-spacing:.4px}\n.nochat{flex:1;display:flex;flex-direction:column;align-items:center;justify-content:center;color:var(--muted);gap:12px}\n.nochat .ico{font-size:44px;opacity:.6}\n.nochat p{font-size:13.5px;text-align:center;line-height:1.6;max-width:320px}\n.msg-input{padding:14px 18px;border-top:1px solid var(--border);display:flex;gap:10px}\n#texto{flex:1;padding:11px 14px;border-radius:12px;border:1px solid var(--border);background:rgba(10,18,36,.7);color:var(--text);font-size:13.5px;outline:none;resize:none;font-family:inherit;transition:.2s}\n#texto:focus{border-color:var(--acc1);box-shadow:0 0 0 3px rgba(124,92,255,.15)}\n#enviar{padding:11px 22px;border:none;border-radius:12px;background:linear-gradient(135deg,var(--acc1),var(--acc2));color:#fff;font-weight:700;font-size:13.5px;cursor:pointer;transition:.15s;box-shadow:0 4px 16px rgba(124,92,255,.35)}\n#enviar:hover{filter:brightness(1.1);transform:translateY(-1px)}\n#enviar:disabled{opacity:.5;cursor:wait;transform:none}\n.hint{padding:0 18px 14px;font-size:11px;color:var(--muted);display:flex;gap:12px;flex-wrap:wrap}\n.hint b{color:var(--text)}\n.badge-live{display:inline-flex;align-items:center;gap:6px;font-size:10.5px;font-weight:700;color:var(--ok);background:rgba(52,211,153,.12);border:1px solid rgba(52,211,153,.3);padding:4px 10px;border-radius:20px;letter-spacing:.5px}\n/* toast */\n#toast{position:fixed;bottom:24px;left:50%;transform:translateX(-50%) translateY(80px);background:rgba(10,18,36,.96);border:1px solid var(--border);color:var(--text);padding:11px 18px;border-radius:12px;font-size:13px;box-shadow:0 10px 30px rgba(0,0,0,.5);transition:.3s;z-index:50;opacity:0;pointer-events:none}\n#toast.show{opacity:1;transform:translateX(-50%) translateY(0)}\n#toast.ok{border-color:rgba(52,211,153,.5);color:var(--ok)}\n#toast.err{border-color:rgba(248,113,113,.5);color:var(--err)}\n@media(max-width:860px){.app{flex-direction:column;height:auto;padding:10px}#lista{width:100%;min-width:0;max-height:38vh}#main{min-height:56vh}}\n</style>\n</head>\n<body>\n<div class=\"app\">\n  <aside id=\"lista\">\n    <div class=\"lista-head\">\n      <div class=\"brand\"><div class=\"logo\">J</div><h1>JeanCRG<small>Panel de conversaciones · WhatsApp</small></h1></div>\n      <input id=\"buscar\" type=\"search\" placeholder=\"Buscar chat…\" autocomplete=\"off\">\n    </div>\n    <div class=\"chat-list\" id=\"chats\"><div class=\"empty\">Cargando conversaciones…</div></div>\n    <div id=\"status\"><span id=\"dot\"></span><span id=\"stxt\">Conectando…</span></div>\n  </aside>\n\n  <section id=\"main\">\n    <div class=\"msg-head\">\n      <div class=\"avatar\" id=\"av\">—</div>\n      <div><div class=\"nm\" id=\"hnm\">Selecciona un chat</div><div class=\"ph\" id=\"hph\">—</div></div>\n      <a class=\"go\" id=\"wame\" href=\"#\" target=\"_blank\" rel=\"noopener\" style=\"visibility:hidden\">Abrir en WhatsApp ↗</a>\n    </div>\n    <div class=\"msg-box\" id=\"msgbox\">\n      <div class=\"nochat\"><div class=\"ico\">💬</div><p><b>Bandeja de entrada de JeanCRG</b><br>Los mensajes llegan aquí en tiempo real. Selecciona un chat para leer la conversación y responder como humano cuando el bot te lo indique.</p></div>\n    </div>\n    <div class=\"msg-input\">\n      <textarea id=\"texto\" rows=\"1\" placeholder=\"Escribe una respuesta como humano… (Enter para enviar)\"></textarea>\n      <button id=\"enviar\">Enviar</button>\n    </div>\n    <div class=\"hint\"><span><b>●</b> Cliente</span><span><b style=\"color:#8b5cf6\">●</b> Bot</span><span><b style=\"color:#f5b942\">●</b> Tu respuesta humana</span><span class=\"badge-live\">● AUTO 15s</span></div>\n  </section>\n</div>\n<div id=\"toast\"></div>\n<script>\nconst $=s=>document.querySelector(s);\nconst params=new URLSearchParams(location.search);\nconst SECRET=params.get('secret')||'';\nconst API={\n  chats:()=>fetch('/webhook/panel-chats?secret='+encodeURIComponent(SECRET)).then(r=>r.json()),\n  mensajes:c=>fetch('/webhook/panel-mensajes?secret='+encodeURIComponent(SECRET)+'&contacto='+encodeURIComponent(c)).then(r=>r.json()),\n  responder:b=>fetch('/webhook/panel-responder',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(b)}).then(r=>r.json())\n};\nconst fmtPhone=p=>{if(!p)return'';let s=String(p);if(s.startsWith('57'))s='+57 '+s.slice(2).replace(/(\\d{3})(\\d{3})(\\d{4})/,'$1 $2 $3');else if(s.startsWith('1'))s='+1 '+s.slice(1).replace(/(\\d{3})(\\d{3})(\\d{4})/,'$1 $2 $3');else s='+'+s;return s};\nconst rel=t=>{if(!t)return'';const d=new Date(t);if(isNaN(d))return t;const n=Date.now(),x=(n-d.getTime())/1000;if(x<60)return'hace un momento';if(x<3600)return' hace '+Math.round(x/60)+' min';if(x<86400)return' hoy '+d.toLocaleTimeString('es-CO',{hour:'2-digit',minute:'2-digit'});return d.toLocaleDateString('es-CO',{day:'2-digit',month:'short'})};\nconst esc=s=>String(s??'').replace(/[&<>\"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;',\"'\":'&#39;'}[c]));\nlet chats=[],act=null,lastKey='';\nfunction toast(msg,kind){const t=$('#toast');t.textContent=msg;t.className='show '+(kind||'');setTimeout(()=>t.className='',2600)}\nfunction setStatus(ok,msg){$('#dot').className=ok?'':'err';$('#stxt').textContent=msg}\nasync function loadChats(){\n  try{\n    const j=await API.chats();\n    if(j.error){setStatus(false,'Sin acceso · revisa el secreto');return}\n    chats=j.chats||[];\n    setStatus(true,'En línea · '+chats.length+' chat'+(chats.length===1?'':'s')+' · '+(new Date().toLocaleTimeString('es-CO',{hour:'2-digit',minute:'2-digit'})));\n    renderList();\n  }catch(e){setStatus(false,'Sin conexión con n8n')}\n}\nfunction renderList(){\n  const q=($('#buscar').value||'').toLowerCase();\n  const list=chats.filter(c=>!q||(c.nombre||'').toLowerCase().includes(q)||(c.telefono||'').includes(q));\n  const box=$('#chats');\n  if(!list.length){box.innerHTML='<div class=\"empty\"><b>Sin conversaciones</b><br>Los mensajes de los últimos 7 días aparecerán aquí.</div>';return}\n  box.innerHTML=list.map(c=>{\n    const k=(c.contacto_id||'')+'|'+(c.ultimo||'');\n    const fresh=k!==lastKey;\n    const name=c.nombre||fmtPhone(c.telefono)||'Contacto sin número';\n    return `<div class=\"chat-item${act===c.contacto_id?' act':''}\" data-id=\"${esc(c.contacto_id)}\" data-tel=\"${esc(c.telefono)}\" data-nm=\"${esc(name)}\">\n      <div class=\"row\"><span class=\"nm${c.nombre?'':' no'}\">${esc(name)}</span><span class=\"t\">${fresh?'<b style=\"color:#8b5cf6\">●</b> ':''}${rel(c.ultimo)}</span></div>\n      <div class=\"sub\">${c.mensajes} mensaje${c.mensajes===1?'':'s'} · último ${rel(c.ultimo)}</div></div>`;\n  }).join('');\n  lastKey=chats.map(c=>c.contacto_id+'|'+(c.ultimo||'')).join(';');\n  box.querySelectorAll('.chat-item').forEach(el=>el.onclick=()=>{act=el.dataset.id;$('#hnm').textContent=el.dataset.nm;$('#hph').textContent=fmtPhone(el.dataset.tel);$('#av').textContent=(el.dataset.nm||'?').trim().charAt(0).toUpperCase();const wa=el.dataset.tel?'https://wa.me/'+el.dataset.tel:'';$('#wame').href=wa;$('#wame').style.visibility=el.dataset.tel?'visible':'hidden';loadMsg()});\n}\nasync function loadMsg(){\n  if(!act)return;\n  try{\n    const j=await API.mensajes(act);\n    if(j.error){toast('Sin acceso al chat','err');return}\n    const box=$('#msgbox');\n    if(!j.mensajes||!j.mensajes.length){box.innerHTML='<div class=\"nochat\"><div class=\"ico\">🫥</div><p>Este chat no tiene mensajes aún.</p></div>';return}\n    box.innerHTML=j.mensajes.map(m=>{\n      const cls=m.role==='user'?'user':(m.derivado_a_humano?'human':'bot');\n      const tag=m.derivado_a_humano?'<span class=\"tag\">TÚ</span>':'';\n      return `<div class=\"msg ${cls}\">${tag}${esc(m.content)}<span class=\"meta\">${esc(m.fecha||'')}</span></div>`;\n    }).join('');\n    box.scrollTop=box.scrollHeight;\n  }catch(e){toast('Error cargando mensajes','err')}\n}\nasync function sendMsg(){\n  const t=$('#texto').value.trim();\n  if(!t){toast('Escribe un mensaje primero','err');return}\n  if(!act){toast('Selecciona un chat primero','err');return}\n  $('#enviar').disabled=true;\n  try{\n    const j=await API.responder({secret:SECRET,contacto_id:act,texto:t});\n    if(j.ok||j.message){toast('Enviado ✓ (procesando…)','ok');$('#texto').value='';loadMsg();loadChats()}\n    else toast('No enviado: '+(j.error||'error'),'err');\n  }catch(e){toast('Error al conectar — verifica que n8n esté activo','err')}\n  $('#enviar').disabled=false;\n}\n$('#enviar').onclick=sendMsg;\n$('#texto').addEventListener('keydown',e=>{if(e.key==='Enter'&&!e.shiftKey){e.preventDefault();sendMsg()}});\n$('#buscar').addEventListener('input',renderList);\nsetInterval(loadChats,15000);\nsetInterval(()=>{if(act)loadMsg()},10000);\nloadChats();\nif(!SECRET){setStatus(false,'Falta el parámetro secret en la URL');$('#chats').innerHTML='<div class=\"empty\"><b>Acceso denegado</b><br>La URL necesita ?secret=jeancrg2026panel</div>'}\n</script>\n</body>\n</html>",
