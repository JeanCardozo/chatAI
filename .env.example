# =====================================================================
# chatAI — variables de entorno (JeanCRG)
# Copiar a .env y completar: cp .env.example .env
# .env esta excluido de git (ver .gitignore). NUNCA versionar credenciales.
# =====================================================================

# --- Postgres (base interna de n8n, docker compose) --------------------
POSTGRES_DB=n8n
POSTGRES_USER=n8n
# Generar con: openssl rand -hex 16
POSTGRES_PASSWORD=

# --- n8n ----------------------------------------------------------------
# CRITICO: clave de cifrado de n8n. Generar con: openssl rand -hex 16
# No perderla: si cambia o se pierde, se pierden TODAS las credenciales guardadas en n8n.
N8N_ENCRYPTION_KEY=

# --- IA Gemini (Google AI Studio, free tier sin tarjeta) ----------------
# Obtener gratis en https://aistudio.google.com/apikey (modelos Flash/Flash-Lite gratuitos)
GEMINI_API_KEY=

# Prompt maestro v2 (prompts/prompt-maestro-v2.md) personalizado por cliente.
# Si esta vacio, el workflow usa un prompt generico de respaldo.
SYSTEM_PROMPT=

# --- Supabase (datos de negocio: contactos, conversaciones, leads, citas) --
# Proyecto gratuito en https://supabase.com. Aplicar supabase/schema.sql antes.
SUPABASE_URL=https://TU-PROYECTO.supabase.co
# Service Role Key: SOLO la usa el backend de n8n, NUNCA exponer en frontend/panel.
# Para el panel del cliente usar la anon key + RLS con policies por tenant_id.
SUPABASE_SERVICE_KEY=

# ID del tenant demo (uuid del seed 'Comercio Demo Tolima' en supabase/schema.sql).
# En produccion, cada cliente tiene su propio tenant.
TENANT_ID=

# --- WhatsApp Cloud API (Meta oficial, PROHIBIDO rutas no oficiales) ----
# Token temporal del dashboard de Meta for Developers (validez ~24h, renovar en pruebas)
# o token permanente para produccion (gestion de tokens en el dashboard).
WHATSAPP_ACCESS_TOKEN=
# Phone number ID del numero de prueba (test number) o del numero real del cliente
WHATSAPP_PHONE_NUMBER_ID=
# Business Account ID de la app de Meta
WHATSAPP_BUSINESS_ACCOUNT_ID=

# --- Telegram (derivacion a humano) -------------------------------------
# Token del bot: crearlo con @BotFather
TELEGRAM_BOT_TOKEN=
# Chat ID donde llegan las derivaciones (el dueño o el grupo de atencion):
# obtenerlo escribiendo al bot y consultando https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_CHAT_ID=

# --- Workflow --------------------------------------------------------------
# Ruta del webhook en n8n (debe coincidir con la configurada en Meta)
WEBHOOK_PATH=whatsapp

# Seguridad — ver docs/DEPLOY-GRATIS.md para el checklist completo
# --- Seguridad: firma de webhook Meta ---
META_APP_SECRET=                # App Secret de la app en Meta for Developers (activar en producción)
WEBHOOK_VERIFY_SIGNATURE=false  # true en producción (requiere META_APP_SECRET)
WHATSAPP_BUSINESS_PHONE=        # Número del negocio (solo dígitos, con código país) para loop prevention

# --- Seguridad: editor n8n (protege el editor cuando el despliegue tiene URL pública) ---
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=        # genera una contraseña fuerte: openssl rand -base64 18
N8N_SECURE_COOKIE=true          # true cuando hay HTTPS (Railway, Render, producción)
